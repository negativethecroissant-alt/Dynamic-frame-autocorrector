// Mod configuration helper synced with Geode Saved/Settings storage
struct Config {
    static bool isEnabled() {
        return Mod::get()->getSettingValue<bool>("enabled");
    }
    static void setEnabled(bool v) {
        Mod::get()->setSettingValue<bool>("enabled", v);
    }

    static int getMaxTicks() {
        int val = static_cast<int>(Mod::get()->getSettingValue<int64_t>("max-ticks"));
        return std::clamp(val, MIN_CORRECTION_TICKS, MAX_CORRECTION_TICKS);
    }
    static void setMaxTicks(int ticks) {
        ticks = std::clamp(ticks, MIN_CORRECTION_TICKS, MAX_CORRECTION_TICKS);
        Mod::get()->setSettingValue<int64_t>("max-ticks", static_cast<int64_t>(ticks));
    }

    static bool correctEarly() {
        return Mod::get()->getSettingValue<bool>("correct-early");
    }
    static void setCorrectEarly(bool v) {
        Mod::get()->setSettingValue<bool>("correct-early", v);
    }

    static bool correctLate() {
        return Mod::get()->getSettingValue<bool>("correct-late");
    }
    static void setCorrectLate(bool v) {
        Mod::get()->setSettingValue<bool>("correct-late", v);
    }

    static bool deathRescue() {
        return Mod::get()->getSettingValue<bool>("death-rescue");
    }
    static void setDeathRescue(bool v) {
        Mod::get()->setSettingValue<bool>("death-rescue", v);
    }

