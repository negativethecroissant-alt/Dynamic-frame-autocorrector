            fullSettingsSpr, this, menu_selector(TickCorrectPopup::onOpenModSettings)
        );
        fullSettingsBtn->setPosition({ winSize.width / 2, winSize.height / 2 - popupSize.height / 2 + 20.f });
        m_buttonMenu->addChild(fullSettingsBtn);

        refreshUI(true);
        cocos2d::CCDirector::sharedDirector()->getTouchDispatcher()->incrementForcePrio(2);
        this->setKeypadEnabled(true);
        this->setTouchEnabled(true);
        return true;
    }

    void addToggleOption(
        const char* labelText,
        bool initialValue,
        cocos2d::CCPoint pos,
        cocos2d::SEL_MenuHandler callback
    ) {
        auto offSpr = cocos2d::CCSprite::createWithSpriteFrameName("GJ_checkOff_001.png");
        auto onSpr = cocos2d::CCSprite::createWithSpriteFrameName("GJ_checkOn_001.png");
        offSpr->setScale(0.68f);
        onSpr->setScale(0.68f);

        auto toggler = CCMenuItemToggler::create(offSpr, onSpr, this, callback);
        toggler->toggle(initialValue);
        toggler->setPosition(pos);
        m_buttonMenu->addChild(toggler);

        auto lbl = cocos2d::CCLabelBMFont::create(labelText, "bigFont.fnt");
        lbl->setScale(0.34f);
        lbl->setAnchorPoint({ 0.f, 0.5f });
        lbl->setPosition({ pos.x + 18.f, pos.y });
        m_mainLayer->addChild(lbl);
    }

    void refreshUI(bool updateSliderPos) {
        int ticks = tc::Config::getMaxTicks();
        float windowMs = (static_cast<float>(ticks) / tc::TICK_RATE) * 1000.0f;

        if (m_windowValueLabel) {
            m_windowValueLabel->setString(
                fmt::format("Auto-Correct Window: {} {}", ticks, ticks == 1 ? "Tick" : "Ticks").c_str()
            );
        }
        if (m_msValueLabel) {
            m_msValueLabel->setString(
                fmt::format("Range: -{}t to +{}t (±{:.2f} ms @ 240 TPS)", ticks, ticks, windowMs).c_str()
            );
        }
        if (updateSliderPos && m_tickSlider) {
            float norm = static_cast<float>(ticks - tc::MIN_CORRECTION_TICKS) /
                         static_cast<float>(tc::MAX_CORRECTION_TICKS - tc::MIN_CORRECTION_TICKS);
            m_tickSlider->setValue(std::clamp(norm, 0.0f, 1.0f));
        }
    }

    void onSliderMoved(cocos2d::CCObject*) {
        if (!m_tickSlider) return;
        float val = std::clamp(m_tickSlider->getValue(), 0.0f, 1.0f);
        int ticks = tc::MIN_CORRECTION_TICKS + static_cast<int>(
            std::round(val * (tc::MAX_CORRECTION_TICKS - tc::MIN_CORRECTION_TICKS))
        );
        tc::Config::setMaxTicks(ticks);
        refreshUI(false);
    }

    void onDecrementTick(cocos2d::CCObject*) {
        tc::Config::setMaxTicks(tc::Config::getMaxTicks() - 1);
        refreshUI(true);
    }

    void onIncrementTick(cocos2d::CCObject*) {
        tc::Config::setMaxTicks(tc::Config::getMaxTicks() + 1);
        refreshUI(true);
    }

    void onPresetClicked(cocos2d::CCObject* sender) {
        auto node = static_cast<cocos2d::CCNode*>(sender);
        if (!node) return;
        tc::Config::setMaxTicks(node->getTag());
        refreshUI(true);
    }

    void onToggleEnabled(cocos2d::CCObject*) {
        tc::Config::setEnabled(!tc::Config::isEnabled());
    }

    void onToggleEarly(cocos2d::CCObject*) {
        tc::Config::setCorrectEarly(!tc::Config::correctEarly());
    }

    void onToggleLate(cocos2d::CCObject*) {
        tc::Config::setCorrectLate(!tc::Config::correctLate());
    }

    void onToggleDeathRescue(cocos2d::CCObject*) {
        tc::Config::setDeathRescue(!tc::Config::deathRescue());
    }

    void onOpenModSettings(cocos2d::CCObject*) {
        geode::openSettingsPopup(Mod::get());
    }

    void onClose(cocos2d::CCObject*) {
        this->setKeypadEnabled(false);
        this->setTouchEnabled(false);
        this->removeFromParentAndCleanup(true);
    }

    void keyBackClicked() override {
        onClose(nullptr);
    }

public:
    static TickCorrectPopup* create() {
        auto ret = new TickCorrectPopup();
        if (ret && ret->init()) {
            ret->autorelease();
            return ret;
        }
        CC_SAFE_DELETE(ret);
        return nullptr;
    }
};


// ============================================================================
// Core 240 TPS Lookahead Simulation & Click Auto-Correction Engine
// ============================================================================
class $modify(TCPlayLayer, PlayLayer) {
    struct Fields {
        cocos2d::CCLabelBMFont* hudLabel = nullptr;
    };

    bool init(GJGameLevel* level, bool useReplay, bool dontCreateObjects) {
        if (!PlayLayer::init(level, useReplay, dontCreateObjects)) return false;

        tc::g_engine.reset();

        // Create subtle in-game HUD label for live tick window & correction status
        auto winSize = cocos2d::CCDirector::sharedDirector()->getWinSize();
        m_fields->hudLabel = cocos2d::CCLabelBMFont::create("", "chatFont.fnt");
        m_fields->hudLabel->setScale(0.55f);
        m_fields->hudLabel->setAnchorPoint({ 0.f, 1.f });
        m_fields->hudLabel->setPosition({ 8.f, winSize.height - 6.f });
        m_fields->hudLabel->setOpacity(195);
        m_fields->hudLabel->setZOrder(9999);
        this->addChild(m_fields->hudLabel);
        updateHudDisplay();

        return true;
    }

    void resetLevel() {
        tc::g_engine.reset();
        PlayLayer::resetLevel();
        tc::g_engine.pushSnapshot(this);
        updateHudDisplay();
    }

    void updateHudDisplay() {
        if (!m_fields->hudLabel) return;
        if (!tc::Config::showHud() || !tc::Config::isEnabled()) {
            m_fields->hudLabel->setVisible(false);
            return;
        }
        m_fields->hudLabel->setVisible(true);
        int maxT = tc::Config::getMaxTicks();
        if (tc::g_engine.statusTimer > 0.0f && tc::g_engine.lastDeltaTicks != 0) {
            const char* dir = (tc::g_engine.lastDeltaTicks < 0) ? "Late" : "Early";
            m_fields->hudLabel->setString(
                fmt::format(
                    "TC [1-{}t]: Corrected {:+d}t ({}) | 480t OK",
                    maxT, tc::g_engine.lastDeltaTicks, dir
                ).c_str()
            );
            m_fields->hudLabel->setColor({ 120, 255, 140 });
        } else {
            m_fields->hudLabel->setString(
                fmt::format("TC [1-{}t @ 240 TPS]: Active (480t check)", maxT).c_str()
            );
            m_fields->hudLabel->setColor({ 220, 235, 255 });
        }
    }

    // Steps a single 240 TPS tick during lookahead verification without audio/visual side effects
    void stepSingleTickSimulation() {
        bool prevSkipAudio = this->m_skipAudioStep;
        this->m_skipAudioStep = true;
        GJBaseGameLayer::update(tc::TICK_DT);
        this->m_skipAudioStep = prevSkipAudio;
    }

    /**
     * Simulates `lookaheadTicks` (default 480 ticks = 2.00s at 240 TPS) forward from
     * the currently loaded PlayLayer state and returns how many ticks the player survived.
     * If the return value >= lookaheadTicks, the candidate tick passes the 480-tick check!
     */
    int simulateForward480Ticks(int lookaheadTicks, bool holdAction, int button, bool isPlayer1) {
        tc::g_engine.simDied = false;
        int survived = 0;

        // Typical human tap hold duration during a click check (~6 ticks = 25ms) if pressing down
        const int tapHoldTicks = 6;

        for (int t = 0; t < lookaheadTicks; ++t) {
            if (holdAction && t == tapHoldTicks) {
                // Release simulated tap after tapHoldTicks so ship/wave/ufo micro-clicks & cube jumps both pass
                GJBaseGameLayer::handleButton(false, button, isPlayer1);
            }
            stepSingleTickSimulation();
            if (tc::g_engine.simDied || (this->m_player1 && this->m_player1->m_isDead)) {
                break;
            }
            ++survived;
        }
        return survived;
    }

    /**
     * Evaluates a click (or release) at tick T:
     * 1. Tests Δ = 0 (current tick T) for 480 ticks at 240 TPS.
     * 2. If Δ = 0 dies within 480 ticks, searches Δ in [-maxTicks, +maxTicks] (1..16 ticks):
     *    - Late click (Δ = -k): Rewinds k ticks in the ring buffer, applies the click at T - k,
     *      and checks if it survives the next 480 ticks.
     *    - Early click (Δ = +k): Advances k ticks before applying the click at T + k,
     *      and checks if it survives the next 480 ticks from T + k.
     * Returns true if the click was handled/corrected by the engine.
     */
    bool evaluateAndAutoCorrectClick(bool down, int button, bool isPlayer1) {
        if (!tc::Config::isEnabled()) return false;
        if (tc::g_engine.isSimulating || tc::g_engine.isApplyingCorrection) return false;

        // Avoid re-correcting on the exact same tick
        if (tc::g_engine.currentTick == tc::g_engine.lastCorrectedTick && tc::g_engine.currentTick > 0) {
            return false;
        }

        const int maxTicks = tc::Config::getMaxTicks();
        const int lookahead = tc::Config::getLookaheadTicks();

        // Save exact present state at tick T before running lookahead simulations
        tc::TickSnapshot presentSnap;
        presentSnap.capture(this, tc::g_engine.currentTick);

        tc::g_engine.isSimulating = true;

        // Step 1: Test raw click at Δ = 0 (current tick T)
        GJBaseGameLayer::handleButton(down, button, isPlayer1);
        int rawSurvived = simulateForward480Ticks(lookahead, down, button, isPlayer1);
        presentSnap.restore(this);

        if (rawSurvived >= lookahead) {
            // Raw click at tick T already passes the 480-tick check!
            tc::g_engine.isSimulating = false;
            return false;
        }

        int bestDelta = 0;
        int bestSurvived = rawSurvived;

        // Step 2: Search outward k = 1 .. maxTicks (1 to 16 ticks) for closest passing tick
        for (int k = 1; k <= maxTicks; ++k) {
            // --- Test LATE Click Correction (Δ = -k: click should have occurred k ticks ago) ---
            if (tc::Config::correctLate()) {
                if (const auto* pastSnap = tc::g_engine.getSnapshotTicksAgo(k)) {
                    pastSnap->restore(this);
                    GJBaseGameLayer::handleButton(down, button, isPlayer1);
                    // Must survive k ticks back to present + 480 ticks ahead
                    int survived = simulateForward480Ticks(k + lookahead, down, button, isPlayer1) - k;
                    if (survived >= lookahead) {
                        bestDelta = -k;
                        bestSurvived = survived;
                        break;
                    }
                    if (survived > bestSurvived + 12) {
                        bestDelta = -k;
                        bestSurvived = survived;
                    }
                }
            }

            // --- Test EARLY Click Correction (Δ = +k: click was k ticks early, delay to T + k) ---
            if (tc::Config::correctEarly()) {
                presentSnap.restore(this);
                tc::g_engine.simDied = false;
                bool diedBeforeDelay = false;

                // Advance k ticks WITHOUT the premature click
                for (int pre = 0; pre < k; ++pre) {
                    stepSingleTickSimulation();
                    if (tc::g_engine.simDied || (this->m_player1 && this->m_player1->m_isDead)) {
                        diedBeforeDelay = true;
                        break;
                    }
                }

                if (!diedBeforeDelay) {
                    // Fire the click at tick T + k and verify 480 ticks from T + k
                    GJBaseGameLayer::handleButton(down, button, isPlayer1);
                    int survived = simulateForward480Ticks(lookahead, down, button, isPlayer1);
                    if (survived >= lookahead) {
                        bestDelta = +k;
                        bestSurvived = survived;
                        break;
                    }
                    if (survived > bestSurvived + 12) {
                        bestDelta = +k;
                        bestSurvived = survived;
                    }
                }
            }
        }

        // Restore present state before applying the chosen correction
        presentSnap.restore(this);
        tc::g_engine.isSimulating = false;

        if (bestDelta == 0) {
            return false;
        }

        // Step 3: Apply the winning tick correction!
        tc::g_engine.isApplyingCorrection = true;
        tc::g_engine.lastCorrectedTick = tc::g_engine.currentTick;
        tc::g_engine.lastDeltaTicks = bestDelta;
        tc::g_engine.statusTimer = 2.0f;

        if (bestDelta < 0) {
            // LATE BY k TICKS: Rewind to T - k, apply click at T - k, and replay k ticks to T
            int k = -bestDelta;
            if (const auto* pastSnap = tc::g_engine.getSnapshotTicksAgo(k)) {
                pastSnap->restore(this);
                GJBaseGameLayer::handleButton(down, button, isPlayer1);
                for (int step = 0; step < k; ++step) {
                    stepSingleTickSimulation();
                }
            }
        } else if (bestDelta > 0) {
            // EARLY BY k TICKS: Suppress premature click at T and schedule it for tick T + k
            tc::DelayedClickCommand cmd;
            cmd.targetTick = tc::g_engine.currentTick + static_cast<uint64_t>(bestDelta);
            cmd.down = down;
            cmd.button = button;
            cmd.isPlayer1 = isPlayer1;
            tc::g_engine.scheduledClicks.push_back(cmd);
        }

        tc::g_engine.isApplyingCorrection = false;
        updateHudDisplay();
        return true;
    }

    void destroyPlayer(PlayerObject* player, GameObject* object) {
        // Ignore spikes/obstacles that equal the anti-cheat test object during level init
        if (!this->m_damageVerified) {
            PlayLayer::destroyPlayer(player, object);
            return;
        }

        // 1. If we are inside the 480-tick lookahead verifier, record death & abort without killing player
        if (tc::g_engine.isSimulating) {
            tc::g_engine.simDied = true;
            return;
        }

        // 2. Real gameplay: if Auto-Rescue on Late Death is enabled, check if clicking 1..16 ticks ago saves us
        if (tc::Config::isEnabled() && tc::Config::deathRescue() && !tc::g_engine.isApplyingCorrection) {
            const int maxTicks = tc::Config::getMaxTicks();
            const int lookahead = tc::Config::getLookaheadTicks();

            tc::TickSnapshot deathSnap;
            deathSnap.capture(this, tc::g_engine.currentTick);

            tc::g_engine.isSimulating = true;
            int rescueTickOffset = 0;
            bool rescueActionDown = true;

            for (int k = 1; k <= maxTicks; ++k) {
                const auto* pastSnap = tc::g_engine.getSnapshotTicksAgo(k);
                if (!pastSnap) continue;

                // Test pressing Jump k ticks ago (and releasing if already holding)
                for (bool tryDown : { true, false }) {
                    pastSnap->restore(this);
                    GJBaseGameLayer::handleButton(tryDown, 1, true);
                    int survived = simulateForward480Ticks(k + lookahead, tryDown, 1, true) - k;
                    if (survived >= lookahead) {
                        rescueTickOffset = -k;
                        rescueActionDown = tryDown;
                        break;
                    }
                }
                if (rescueTickOffset != 0) break;
            }

            deathSnap.restore(this);
            tc::g_engine.isSimulating = false;

            if (rescueTickOffset < 0) {
                int k = -rescueTickOffset;
                if (const auto* pastSnap = tc::g_engine.getSnapshotTicksAgo(k)) {
                    tc::g_engine.isApplyingCorrection = true;
                    pastSnap->restore(this);
                    GJBaseGameLayer::handleButton(rescueActionDown, 1, true);
                    for (int step = 0; step < k; ++step) {
                        stepSingleTickSimulation();
                    }
                    tc::g_engine.isApplyingCorrection = false;
                    tc::g_engine.lastCorrectedTick = tc::g_engine.currentTick;
                    tc::g_engine.lastDeltaTicks = rescueTickOffset;
                    tc::g_engine.statusTimer = 2.0f;
                    updateHudDisplay();
                    return; // Player survived the click check!
                }
            }
        }

        PlayLayer::destroyPlayer(player, object);
    }
};


// ============================================================================
// 240 TPS Physics Tick Hook & Input Interceptor on GJBaseGameLayer
// ============================================================================
class $modify(TCBaseGameLayer, GJBaseGameLayer) {
    void update(float dt) {
        auto* pl = PlayLayer::get();
        if (!pl || static_cast<GJBaseGameLayer*>(pl) != this || tc::g_engine.isSimulating) {
            GJBaseGameLayer::update(dt);
            return;
        }

        if (!tc::Config::isEnabled() || pl->m_isPaused || (pl->m_player1 && pl->m_player1->m_isDead)) {
            GJBaseGameLayer::update(dt);
            return;
        }

        // Update HUD status timer
        if (tc::g_engine.statusTimer > 0.0f) {
            tc::g_engine.statusTimer = std::max(0.0f, tc::g_engine.statusTimer - dt);
            static_cast<TCPlayLayer*>(pl)->updateHudDisplay();
        }

        // Step physics at 240 TPS (dt = 1/240s) so 1-16 tick window & 480-tick check are exact
        tc::g_engine.tickAccumulator += std::min(dt, 0.1f);
        int steps = static_cast<int>(std::floor(tc::g_engine.tickAccumulator / tc::TICK_DT));
        if (steps <= 0) {
            // Sub-tick frame: record snapshot and advance normally
            tc::g_engine.pushSnapshot(pl);
            ++tc::g_engine.currentTick;
            fireScheduledClicksForCurrentTick(pl);
            GJBaseGameLayer::update(dt);
            tc::g_engine.tickAccumulator = 0.0f;
            return;
        }

        tc::g_engine.tickAccumulator -= steps * tc::TICK_DT;
        steps = std::min(steps, 16); // Cap burst steps on lag spikes

        for (int s = 0; s < steps; ++s) {
            tc::g_engine.pushSnapshot(pl);
            ++tc::g_engine.currentTick;
            fireScheduledClicksForCurrentTick(pl);
            GJBaseGameLayer::update(tc::TICK_DT);
        }
    }

    void fireScheduledClicksForCurrentTick(PlayLayer* pl) {
        if (tc::g_engine.scheduledClicks.empty()) return;
        tc::g_engine.isApplyingCorrection = true;
        auto it = tc::g_engine.scheduledClicks.begin();
        while (it != tc::g_engine.scheduledClicks.end()) {
            if (tc::g_engine.currentTick >= it->targetTick) {
                GJBaseGameLayer::handleButton(it->down, it->button, it->isPlayer1);
                it = tc::g_engine.scheduledClicks.erase(it);
            } else {
                ++it;
            }
        }
        tc::g_engine.isApplyingCorrection = false;
    }

    void handleButton(bool down, int button, bool isPlayer1) {
        auto* pl = static_cast<TCPlayLayer*>(PlayLayer::get());
        if (pl && static_cast<GJBaseGameLayer*>(pl) == this &&
            !tc::g_engine.isSimulating && !tc::g_engine.isApplyingCorrection) {
            if (pl->evaluateAndAutoCorrectClick(down, button, isPlayer1)) {
                return; // Click was auto-corrected to the passing tick!
            }
        }
        GJBaseGameLayer::handleButton(down, button, isPlayer1);
    }
};


