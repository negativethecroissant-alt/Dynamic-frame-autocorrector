struct TickSnapshot {
    uint64_t tickIndex = 0;
    double attemptTime = 0.0;
    double currentTime = 0.0;
    PlayerPhysicsSnapshot p1;
    PlayerPhysicsSnapshot p2;

    void capture(PlayLayer* pl, uint64_t tick) {
        tickIndex = tick;
        attemptTime = pl->m_attemptTime;
        currentTime = pl->m_currentTime;
        p1.captureFrom(pl->m_player1);
        p2.captureFrom(pl->m_player2);
    }

    void restore(PlayLayer* pl) const {
        pl->m_attemptTime = attemptTime;
        pl->m_currentTime = currentTime;
        p1.restoreTo(pl->m_player1);
        p2.restoreTo(pl->m_player2);
    }
};

// Scheduled delayed click when a click was 1-16 ticks too EARLY
struct DelayedClickCommand {
    uint64_t targetTick = 0;
    bool down = true;
    int button = 1;
    bool isPlayer1 = true;
};

// Global runtime state for the active PlayLayer session
struct EngineState {
    uint64_t currentTick = 0;
    float tickAccumulator = 0.0f;
    bool isSimulating = false;
    bool simDied = false;
    bool isApplyingCorrection = false;
    uint64_t lastCorrectedTick = 0;

    std::deque<TickSnapshot> history;
    std::vector<DelayedClickCommand> scheduledClicks;

    // HUD feedback state
    std::string lastStatusText = "Ready";
    int lastDeltaTicks = 0;
    float statusTimer = 0.0f;

    void reset() {
        currentTick = 0;
        tickAccumulator = 0.0f;
        isSimulating = false;
        simDied = false;
        isApplyingCorrection = false;
        lastCorrectedTick = 0;
        history.clear();
        scheduledClicks.clear();
        lastStatusText = "Ready";
        lastDeltaTicks = 0;
        statusTimer = 0.0f;
    }

    void pushSnapshot(PlayLayer* pl) {
        TickSnapshot snap;
        snap.capture(pl, currentTick);
        history.push_back(std::move(snap));
        while (history.size() > RING_BUFFER_CAPACITY) {
            history.pop_front();
        }
    }

    const TickSnapshot* getSnapshotTicksAgo(int ticksAgo) const {
        if (ticksAgo <= 0 || history.empty()) return nullptr;
        size_t idxFromBack = static_cast<size_t>(ticksAgo);
        if (idxFromBack > history.size()) return nullptr;
        return &history[history.size() - idxFromBack];
    }
};

